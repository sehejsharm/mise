# ─────────────────────────────────────────────────────────────────────────────
# misehotel.com — environment variables
# Copy to .env.local for local development. Set the same keys in
# Vercel → Project → Settings → Environment Variables for Production/Preview.
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time.
# ─────────────────────────────────────────────────────────────────────────────

# Canonical origin. Every canonical tag, sitemap URL, OG URL and JSON-LD @id is
# built from this. Apex domain, no trailing slash.
NEXT_PUBLIC_SITE_URL=https://misehotel.com

# Google Analytics 4: the measurement ID (G-KVTTR7P7BY) is fixed in lib/analytics.ts and
# loaded once per page behind Consent Mode v2. There is no env override.

# Public contact address shown on the site and in schema.
NEXT_PUBLIC_CONTACT_EMAIL=hello@misehotel.com

# Public phone number (shown in footer, contact page, schema contactPoint).
NEXT_PUBLIC_CONTACT_PHONE=+91 93221 07991

# Optional. A Cal.com / Calendly booking URL, e.g. https://cal.com/mise/15min
# When set, /demo embeds the scheduler inline next to the form and again in the
# success state. When empty, /demo shows the form only.
NEXT_PUBLIC_BOOKING_URL=

# ── Lead delivery (demo, contact and newsletter forms) ───────────────────────
# Resend API key (https://resend.com/api-keys). Required in production: without
# it the /api/lead route returns 503 rather than silently dropping leads.
RESEND_API_KEY=
# Inbox that receives demo requests, contact messages and newsletter sign-ups.
DEMO_INBOX_EMAIL=hello@misehotel.com
# Verified Resend sender, e.g. "Mise <website@misehotel.com>". The domain must
# be verified in Resend first.
RESEND_FROM_EMAIL=Mise website <website@misehotel.com>
# Set to 1 only for local testing / CI: accepts leads without sending email.
LEAD_DRY_RUN=

# ── Search engine verification (rendered as <meta> tags when set) ────────────
# Defaults to the misehotel.com Search Console token in app/layout.tsx; set only to override.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# ── IndexNow (Bing, Yandex, Seznam, Naver) ───────────────────────────────────
# Any 8–128 character hex string. Served at /indexnow-key.txt; the post-build
# script pings IndexNow with every sitemap URL on production builds only.
INDEXNOW_KEY=

# ── Keystatic CMS (/keystatic) ───────────────────────────────────────────────
# Leave empty to edit content locally (writes to the working copy).
# In production, create the Keystatic GitHub App by visiting /keystatic once on
# a local build with these empty, then copy the generated values here.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# ── Blog drafts ──────────────────────────────────────────────────────────────
# Draft posts are visible on local and Preview builds and hidden on Production.
# Set to 1 to force drafts on (e.g. a staging domain), 0 to force them off.
BLOG_SHOW_DRAFTS=

# ── Build tooling ────────────────────────────────────────────────────────────
# ANALYZE=true pnpm build opens the bundle analyzer.
ANALYZE=

# Optional. Lead submissions allowed per IP per 10 minutes (default 6).
LEAD_RATE_LIMIT=
