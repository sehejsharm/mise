{
  "name": "misehotel",
  "version": "1.0.0",
  "private": true,
  "description": "misehotel.com — the marketing site for Mise, the service execution platform for hotels.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/copy-lint.mjs && node scripts/check-images.mjs && node scripts/indexnow.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "images": "node scripts/process-images.mjs",
    "check:images": "node scripts/check-images.mjs",
    "check:copy": "node scripts/copy-lint.mjs",
    "check:links": "node scripts/check-external-links.mjs",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "lhci": "lhci autorun && lhci autorun --config=lighthouserc.desktop.json",
    "seo:report": "node scripts/seo-report.mjs",
    "analyze": "ANALYZE=true next build"
  },
  "dependencies": {
    "@keystatic/core": "0.6.9",
    "@keystatic/next": "5.0.5",
    "@markdoc/markdoc": "0.4.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "framer-motion": "13.4.5",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "next": "15.5.26",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.30.0",
    "server-only": "^0.0.1",
    "three": "0.186.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/eslintrc": "^3",
    "@lhci/cli": "0.15.1",
    "@next/bundle-analyzer": "15.5.26",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.26",
    "node-html-parser": "^9.0.4",
    "opentype.js": "^2.0.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "schema-dts": "2.0.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "^5.7"
  }
}
